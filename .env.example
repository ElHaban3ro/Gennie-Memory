# Ruta obligatoria, relativa a la raíz del proyecto o absoluta.
IROMEM_DATABASE_PATH=.local/iromem.db

# Opcional hasta integrar OpenRouter. Nombre proporcionado por el usuario; no versionar el valor.
# IROMEM_OPENROUTER_API_KEY=<CONFIGURAR_EN_ENV_O_ENV_LOCAL>

# Solo evaluación: ruta nueva para un JSONL de hashes/metadatos del transporte; no guarda prompts ni respuestas.
# IROMEM_EVALUATION_CAPTURE_PATH=/ruta/nueva/evaluation-capture.jsonl

# Solo cohortes sintéticas: conserva el JSON de contenido emitido por el modelo; puede incluir texto de entrada.
# Archivo local nuevo con permisos restrictivos. Mantener vacío en uso normal.
# IROMEM_EVALUATION_RESPONSE_CONTENT_PATH=/ruta/nueva/evaluation-response-content.jsonl
